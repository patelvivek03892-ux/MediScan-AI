# ==============================================================================
# MEDISCAN-AI BACKEND ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# Copy this file to .env in `apps/api/.env`:
# cp .env.example .env
# ==============================================================================

# General Application Settings
ENVIRONMENT=development
DEBUG=true
FRONTEND_URL=http://localhost:3000

# Security / Authentication
SECRET_KEY=your-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==============================================================================
# OUTBOUND SMTP EMAIL CONFIGURATION (LOCAL & PRODUCTION)
# ==============================================================================
# The backend connects OUTBOUND directly to your SMTP server over TCP/TLS.
# No public IP, public domain, or webhook is required for local development.
#
# If the variables below are left blank or set to defaults, MediScan AI enters
# SAFE DEVELOPMENT MODE: emails are validated, fully rendered to HTML/text, and
# appended to `apps/api/logs/email_dispatches.log` without crashing.

# ------------------------------------------------------------------------------
# OPTION 1: GMAIL SMTP (Recommended for Local Dev & Testing)
# ------------------------------------------------------------------------------
# 1. Ensure 2-Step Verification is enabled on your Google Account:
#    https://myaccount.google.com/security
# 2. Go to: Security -> "2-Step Verification" -> "App Passwords"
#    (Or search "App Passwords" in the search box).
# 3. Create a new App Password named "MediScan AI".
# 4. Copy the 16-character generated password (e.g. "abcd efgh ijkl mnop").
#
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=abcdefghijklmnop
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=your-email@gmail.com
# MAIL_FROM_NAME=MediScan AI Healthcare Intelligence
# MAIL_REPLY_TO=your-email@gmail.com

# ------------------------------------------------------------------------------
# OPTION 2: PRODUCTION SMTP (SendGrid, Mailgun, Amazon SES, Postmark)
# ------------------------------------------------------------------------------
# MAIL_HOST=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=SG.your_sendgrid_api_key_here
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=notifications@yourdomain.com
# MAIL_FROM_NAME=MediScan AI Healthcare Intelligence

# ------------------------------------------------------------------------------
# OPTION 3: LOCAL SMTP DUMMY SERVER (Mailpit / MailHog / Papercut)
# ------------------------------------------------------------------------------
# If running Mailpit on localhost:1025:
# MAIL_HOST=localhost
# MAIL_PORT=1025
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=none
# MAIL_FROM_ADDRESS=no-reply@mediscan.local
# MAIL_FROM_NAME=MediScan AI Local

# ------------------------------------------------------------------------------
# CURRENT ACTIVE SETTINGS (Defaults to Safe Development Logger if empty)
# ------------------------------------------------------------------------------
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@mediscan.ai
MAIL_FROM_NAME=MediScan AI Healthcare Intelligence
MAIL_REPLY_TO=
MAIL_TIMEOUT_SECONDS=10
